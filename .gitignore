coverage/

# build output
.next/
out/
dist/
build/
_site/

# env files (can opt-in for committing if needed)
.env*
!.env.example

# logs
*-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# typescript
*.tsbuildinfo
next-env.d.ts

# misc
.DS_Store
*.pem
.vercel

# agent collaboration (temporary, not part of the deliverable)
.agents-ssw/
