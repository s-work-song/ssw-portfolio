# 모노레포 루트 — apps/* 하위의 산출물까지 함께 무시한다.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

