{
  "name": "ssw-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "node scripts/generate-posts.mjs && next build",
    "dev": "node scripts/generate-posts.mjs && next dev",
    "start": "next start",
    "lint": "eslint",
    "preview": "node scripts/generate-posts.mjs && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "node scripts/generate-posts.mjs && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "node scripts/generate-posts.mjs && opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.1",
    "gray-matter": "^4.0.3",
    "next": "16.2.9",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "typescript": "^5",
    "wrangler": "^4.105.0"
  }
}
