{
  "name": "portfolio-rag-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test",
    "rag:demo": "node scripts/rag-demo.js",
    "rag:eval": "node scripts/rag-eval.js",
    "rag:eval:orama": "node scripts/rag-eval.js --store=orama",
    "rag:smoke:real": "node scripts/rag-eval.js --real --smoke",
    "serve:sample": "node scripts/serve-sample.js"
  },
  "dependencies": {
    "@orama/orama": "3.1.18"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "4.2.0"
  }
}
