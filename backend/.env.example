# 이 파일을 .env로 복사한 뒤 실제 값을 입력하세요.
# OPENAI_API_KEY는 backend/.env에서만 읽습니다.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://your-colab-host.example/v1
OPENAI_MODEL=your-vllm-model-name

HOST=127.0.0.1
PORT=8787
CORS_ORIGIN=*
# 신뢰할 수 있는 reverse proxy 바로 뒤에서 실행할 때만 true
TRUST_PROXY=false
# vLLM이 일시적으로 꺼져 있을 때 고정 안내문을 HTTP 200으로 반환
OFFLINE_FALLBACK_ENABLED=true
# RAG 원문(knowledge) 폴더 경로. 미설정이면 backend/../knowledge를 씁니다.
# 상대 경로는 backend/ 기준으로 해석하므로, 비공개 저장소를 나란히 클론했다면
# RAG_KNOWLEDGE_DIR=../../ssw-portfolio-private/knowledge 처럼 지정합니다.
RAG_KNOWLEDGE_DIR=
# 기본 lexical은 임베딩 모델을 로드하지 않습니다.
RAG_RETRIEVER_MODE=lexical
RAG_VECTOR_STORE=memory
RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-small
RAG_EMBEDDING_MODEL_REVISION=main
RAG_EMBEDDING_CACHE_DIR=
RAG_EMBEDDING_LOCAL_FILES_ONLY=false
RAG_EMBEDDING_MAX_LENGTH=512
TOP_K=5
# top-K 안에서 같은 문서의 청크를 최대 몇 개까지 허용할지 (0이면 상한 없음).
# faq처럼 Q&A마다 청크가 잘게 나뉜 파생 문서가 top-K를 독점해 정본 문서가
# 근거에서 통째로 빠지는 것을 막는다. lexical/dense/hybrid 세 모드에 공통 적용.
RAG_DIVERSITY_MAX_PER_SOURCE=2
# 상한으로 생긴 빈자리를 1위 점수 대비 이 비율 미만인 청크로는 채우지 않는다.
# 0이면 하한 없이 다음 순위로 채운다 — 다양성은 오르지만 관련 없는 청크가 근거에 섞인다.
RAG_DIVERSITY_MIN_PROMOTION_RATIO=0.2
MAX_BODY_BYTES=32768
MAX_MESSAGE_CHARS=2000
MAX_HISTORY_ITEMS=6
MAX_HISTORY_CHARS=6000
MAX_EVIDENCE_CHARS=12000
# 공개 API는 기본적으로 검색 근거를 노출하지 않음 (none | metadata | excerpt)
RAG_SOURCE_EXPOSURE=none
SOURCE_EXCERPT_CHARS=280
UPSTREAM_CONCURRENCY=1
MAX_UPSTREAM_QUEUE=4
UPSTREAM_TIMEOUT_MS=30000
# 채팅창을 열 때 사용하는 실제 모델 서버 상태 확인 제한 시간과 결과 캐시
UPSTREAM_STATUS_TIMEOUT_MS=3000
UPSTREAM_STATUS_CACHE_TTL_MS=5000
RATE_WINDOW_MS=60000
RATE_LIMIT_PER_IP=10
RATE_LIMIT_GLOBAL=30
CACHE_TTL_MS=15000
FALLBACK_CACHE_TTL_MS=5000
